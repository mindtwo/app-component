{
    "name": "@mindtwo/app-component-nuxt-scripts",
    "version": "0.0.0",
    "type": "module",
    "description": "nuxt-scripts adapter for @mindtwo/unplugin-app-component's manifest loader",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "tsdown",
        "dev": "tsdown -w",
        "typecheck": "tsc --noEmit",
        "lint:check": "eslint --cache .",
        "lint:fix": "npm run lint:check -- --fix",
        "build": "npm run typecheck && npm run prepack"
    },
    "author": "mindtwo",
    "license": "ISC",
    "devDependencies": {
        "tsdown": "^0.22.1",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@mindtwo/unplugin-app-component": "workspace:*",
        "@unhead/vue": "^1.0.0 || ^2.0.0"
    }
}
