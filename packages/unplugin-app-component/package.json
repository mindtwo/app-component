{
    "name": "@mindtwo/unplugin-app-component",
    "type": "module",
    "description": "Vite plugin to define app-components and other utility to use with the plugin",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./vite": {
            "types": "./dist/vite.d.mts",
            "default": "./dist/vite.mjs"
        },
        "./rolldown": {
            "types": "./dist/rolldown.d.mts",
            "default": "./dist/rolldown.mjs"
        },
        "./rollup": {
            "types": "./dist/rollup.d.mts",
            "default": "./dist/rollup.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "tsdown",
        "dev": "tsdown -w",
        "test": "vitest",
        "typecheck": "tsc --noEmit",
        "lint:check": "eslint --cache .",
        "lint:fix": "npm run lint --fix",
        "build": "npm run typecheck && npm run prepack",
        "postbuild": "cp ./src/util/manifest-loader.template.js ./dist/manifest-loader.template"
    },
    "author": "mindtwo",
    "license": "ISC",
    "devDependencies": {
        "@sxzz/test-utils": "^0.5.18",
        "just-kebab-case": "^4.2.0",
        "just-pascal-case": "^3.2.0",
        "rollup": "^4.60.4",
        "tsdown": "^0.22.1",
        "typescript": "^6.0.3",
        "unplugin": "^3.0.0",
        "unrun": "^0.3.0"
    },
    "peerDependencies": {
        "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
        "rollup": "^4.0.0",
        "rolldown": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "vite": { "optional": true },
        "rollup": { "optional": true },
        "rolldown": { "optional": true }
    }
}
