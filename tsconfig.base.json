{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "moduleResolution": "Node",
        "module": "esnext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": ["**/dist/**", "eslint.config.js"]
}
